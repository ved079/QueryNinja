{
  "id": "customer-most-orders",
  "number": 196,
  "title": "Customer Placing the Largest Number of Orders",
  "difficulty": "Easy",
  "tags": [
    "Aggregation",
    "Argmax",
    "Ties"
  ],
  "top50": true,
  "description": "Table `orders`. Return the `customer_number` of the customer(s) with the most orders. **If multiple customers tie at the maximum, return all of them.**",
  "schemaSql": "CREATE TABLE orders (order_number INTEGER, customer_number INTEGER);",
  "solutionSql": "SELECT customer_number FROM orders GROUP BY customer_number HAVING COUNT(*) = (SELECT COUNT(*) c FROM orders GROUP BY customer_number ORDER BY c DESC LIMIT 1);",
  "orderMatters": false,
  "hint": "A subquery finds the max order count; HAVING keeps every customer whose count equals that max (handles ties).",
  "tests": [
    {
      "name": "clear winner",
      "seedSql": "INSERT INTO orders VALUES (1,1),(2,1),(3,1),(4,2),(5,2),(6,3);",
      "expectedOutput": [
        {
          "customer_number": 1
        }
      ]
    },
    {
      "name": "tie at top → both",
      "seedSql": "INSERT INTO orders VALUES (1,1),(2,1),(3,1),(4,2),(5,2),(6,2);",
      "expectedOutput": [
        {
          "customer_number": 1
        },
        {
          "customer_number": 2
        }
      ]
    },
    {
      "name": "single customer",
      "seedSql": "INSERT INTO orders VALUES (1,1),(2,1),(3,1),(4,1),(5,1);",
      "expectedOutput": [
        {
          "customer_number": 1
        }
      ]
    },
    {
      "name": "all tie at 1 → all",
      "seedSql": "INSERT INTO orders VALUES (1,1),(2,2),(3,3);",
      "expectedOutput": [
        {
          "customer_number": 1
        },
        {
          "customer_number": 2
        },
        {
          "customer_number": 3
        }
      ]
    },
    {
      "name": "empty table → empty",
      "expectedOutput": []
    },
    {
      "name": "one with many, one with few",
      "seedSql": "INSERT INTO orders VALUES (1,1),(2,1),(3,1),(4,1),(5,1),(6,1),(7,1),(8,1),(9,1),(10,1),(11,2);",
      "expectedOutput": [
        {
          "customer_number": 1
        }
      ]
    },
    {
      "name": "two tie, one fewer",
      "seedSql": "INSERT INTO orders VALUES (1,1),(2,1),(3,1),(4,1),(5,2),(6,2),(7,2),(8,2),(9,3),(10,3),(11,3);",
      "expectedOutput": [
        {
          "customer_number": 1
        },
        {
          "customer_number": 2
        }
      ]
    },
    {
      "name": "all same count 2 → all",
      "seedSql": "INSERT INTO orders VALUES (1,1),(2,1),(3,2),(4,2),(5,3),(6,3),(7,4),(8,4);",
      "expectedOutput": [
        {
          "customer_number": 1
        },
        {
          "customer_number": 2
        },
        {
          "customer_number": 3
        },
        {
          "customer_number": 4
        }
      ]
    }
  ]
}
