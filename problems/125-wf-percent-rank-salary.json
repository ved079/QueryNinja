{
  "id": "wf-percent-rank-salary",
  "number": 125,
  "title": "Salary Percentile Rank Within Department",
  "difficulty": "Medium",
  "tags": [
    "Window Function"
  ],
  "description": "For every employee, report their salary's percentile rank **within their own department** using `PERCENT_RANK()`, rounded to 4 decimals. It ranges from 0 (the lowest paid in the department) to 1 (the highest paid).\n\nName the columns `name` and `pct_rank`. Return the result in any order.",
  "solutionSql": "SELECT name,\n  ROUND(PERCENT_RANK() OVER (PARTITION BY dept_id ORDER BY salary), 4) AS pct_rank\nFROM employees;",
  "orderMatters": false,
  "hint": "PERCENT_RANK() is (rank - 1) / (rows in partition - 1) — a department with only one employee always gives that employee 0, since there's no spread to rank against.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "name": "Dan",
          "pct_rank": 0
        },
        {
          "name": "Ben",
          "pct_rank": 0.3333
        },
        {
          "name": "Cara",
          "pct_rank": 0.3333
        },
        {
          "name": "Ava",
          "pct_rank": 1
