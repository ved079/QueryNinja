{
  "id": "da-first-purchase-month",
  "number": 165,
  "title": "First Purchase Month Per Customer",
  "difficulty": "Easy",
  "tags": [
    "Data Analyst",
    "Subquery",
    "Aggregation"
  ],
  "description": "For each customer, report the calendar month of their very **first** purchase. Name the columns `customer_id` and `first_month`. Oldest purchase wins; ties don't matter. Return customers in any order.",
  "solutionSql": "SELECT customer_id,\n       strftime('%Y-%m', MIN(order_date)) AS first_month\nFROM orders\nGROUP BY customer_id;",
  "orderMatters": false,
  "hint": "MIN(order_date) is each customer's first purchase; strftime down to month.",
  "outputExplanation": "Alice first bought in January, Zed in February.",
  "schemaSql": "CREATE TABLE orders (\n  id INTEGER PRIMARY KEY,\n  customer_id INTEGER,\n  order_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO orders VALUES (1,10,'2024-01-05'),(2,10,'2024-02-20'),(3,20,'2024-02-01'),(4,30,'2024-01-15');",
      "expectedOutput": [
        {
          "customer_id": 10,
          "first_month": "2024-01"
        },
        {
          "customer_id": 20,
          "first_month": "2024-02"
        },
        {
          "customer_id": 30,
          "first_month": "2024-01"
        }
      ],
      "expectedHash": "014621f833d80346ab92cced21b32593df36ce12cda5ccf841b2cc4ccbcd7da2"
    },
    {
      "name": "Many purchases for one customer",
      "seedSql": "INSERT INTO orders VALUES (1,1,'2024-03-01'),(2,1,'2024-01-01'),(3,1,'2024-02-01');",
      "expectedOutput": [
        {
          "customer_id": 1,
          "first_month": "2024-01"
        }
      ],
      "expectedHash": "1e8910f2b77852e5064f2a92b29a734e6d4d6f3b17452204bfc8f866bdb7e75e"
    },
    {
      "name": "Empty table",
      "seedSql": "",
      "expectedOutput": [],
      "expectedHash": "ed1652f78cc4b15ad65fbd0712cf5c4f63a46706aae94b6e55ed1b13440fd075"
    },
    {
      "name": "Each customer once",
      "seedSql": "INSERT INTO orders VALUES (1,1,'2024-06-01'),(2,2,'2024-07-01');",
      "expectedOutput": [
        {
          "customer_id": 1,
