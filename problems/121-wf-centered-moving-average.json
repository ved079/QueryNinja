{
  "id": "wf-centered-moving-average",
  "number": 121,
  "title": "Centered 3-Employee Moving Average",
  "difficulty": "Easy",
  "tags": [
    "Window Function"
  ],
  "description": "Order employees by hire date. For each one, report the average salary across **the employee hired just before them, themselves, and the employee hired just after them** (a centered 3-row window — fewer than 3 rows at either edge is fine).\n\nName the columns `name` and `centered_avg` (rounded to 2 decimals). Return the result in any order.",
  "solutionSql": "SELECT name,\n  ROUND(AVG(salary) OVER (ORDER BY hire_date, id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING), 2) AS centered_avg\nFROM employees;",
  "orderMatters": false,
  "hint": "\"Just before and just after\" is an explicit frame, not the default — `ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING`. The default frame (nothing after ORDER BY) would only look backward, never forward.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
