{
  "id": "emp-managers-of-big-teams",
  "number": 34,
  "title": "Managers Of Three Or More",
  "difficulty": "Medium",
  "tags": [
    "Self Join",
    "Having"
  ],
  "description": "Report the name of every manager with **three or more** direct reports.\n\nName the column `manager`. Return the result in any order.",
  "solutionSql": "SELECT m.name AS manager\nFROM employees e\nJOIN employees m ON m.id = e.manager_id\nGROUP BY m.id, m.name\nHAVING COUNT(*) >= 3;",
  "orderMatters": false,
  "hint": "Same self-join as counting direct reports, with a HAVING filter on the count.",
  "outputExplanation": "Only Ava manages three or more people (3 direct reports). Eve has 2 and does not qualify.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "manager": "Ava"
        }
      ],
      "expectedHash": "ddd97427a6fa96319874669b753efbfedffcb344b3eb43b057217eb91cab5fee"
    },
