{
  "id": "act-first-last-event",
  "number": 76,
  "title": "First And Last Activity",
  "difficulty": "Medium",
  "tags": [
    "Aggregation",
    "Join"
  ],
  "description": "For every user who has at least one event, report the timestamp of their earliest and latest event.\n\nName the columns `name`, `first_seen` and `last_seen`. Return the result in any order.",
  "solutionSql": "SELECT u.name, MIN(e.event_time) AS first_seen, MAX(e.event_time) AS last_seen\nFROM users u\nJOIN events e ON e.user_id = u.id\nGROUP BY u.id, u.name;",
  "orderMatters": false,
  "hint": "ISO timestamps sort correctly as text, so MIN and MAX work directly on them.",
  "outputExplanation": "Ada's activity spans from March 1 to March 3, Bo's from March 1 to March 5, and Cy's from March 2 to March 4.",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO users VALUES (1,'Ada','pro','2022-01-01'),(2,'Bo','free','2022-01-03'),(3,'Cy','pro','2022-02-10'),(4,'Di','free','2022-03-01');\nINSERT INTO events VALUES\n (1,1,'login','2022-03-01 09:00:00'),\n (2,1,'view','2022-03-01 09:05:00'),\n (3,1,'purchase','2022-03-01 09:40:00'),\n (4,1,'login','2022-03-02 10:00:00'),\n (5,1,'login','2022-03-03 11:00:00'),\n (6,2,'login','2022-03-01 08:00:00'),\n (7,2,'view','2022-03-05 08:10:00'),\n (8,3,'login','2022-03-02 20:00:00'),\n (9,3,'purchase','2022-03-02 20:30:00'),\n (10,3,'login','2022-03-04 21:00:00');",
      "expectedOutput": [
        {
          "name": "Ada",
          "first_seen": "2022-03-01 09:00:00",
          "last_seen": "2022-03-03 11:00:00"
        },
        {
          "name": "Bo",
          "first_seen": "2022-03-01 08:00:00",
          "last_seen": "2022-03-05 08:10:00"
        },
        {
          "name": "Cy",
          "first_seen": "2022-03-02 20:00:00",
          "last_seen": "2022-03-04 21:00:00"
        }
      ],
      "expectedHash": "4636b3a6e891c04509467602c46fe02e73266feaa11e8361d9a457328ae8d2e7"
    },
