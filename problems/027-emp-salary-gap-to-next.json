{
  "id": "emp-salary-gap-to-next",
  "number": 27,
  "title": "Gap To The Next Highest Salary",
  "difficulty": "Medium",
  "tags": [
    "Window Function"
  ],
  "description": "Order all employees by salary from highest to lowest and, for each one, report how much less they earn than the person directly above them. The top earner reports `NULL`.\n\nName the columns `name`, `salary` and `gap`. Return the result in any order.",
  "solutionSql": "SELECT name, salary,\n       LAG(salary) OVER (ORDER BY salary DESC, id) - salary AS gap\nFROM employees;",
  "orderMatters": false,
  "hint": "LAG() reaches backwards one row in the window's order. Add a tie-breaker to the ORDER BY so the answer is deterministic.",
  "outputExplanation": "Ava ($150k) is the top earner and has no gap. Eve ($130k) is $20k behind Ava. Ben and Cara ($120k) follow, then Dan ($95k), Gia ($85k), Finn ($70k) and Hal ($60k).",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
