{
  "id": "emp-total-team-size",
  "number": 37,
  "title": "Total Team Size Including Indirect Reports",
  "difficulty": "Hard",
  "tags": [
    "Recursive CTE",
    "Hierarchy"
  ],
  "description": "For every employee who manages at least one person, report how many people sit below them in the tree — direct reports plus everyone under those reports, all the way down.\n\nName the columns `manager` and `team_size`. Return the result in any order.",
  "solutionSql": "WITH RECURSIVE tree(root, id) AS (\n  SELECT manager_id, id FROM employees WHERE manager_id IS NOT NULL\n  UNION ALL\n  SELECT t.root, e.id\n  FROM employees e\n  JOIN tree t ON e.manager_id = t.id\n)\nSELECT m.name AS manager, COUNT(*) AS team_size\nFROM tree t\nJOIN employees m ON m.id = t.root\nGROUP BY t.root, m.name;",
  "orderMatters": false,
  "hint": "Seed the recursion with every (manager, direct report) pair, then keep attaching each report's own reports to the same root.",
  "outputExplanation": "Ava has 3 people below her in the management tree, and Eve has 2.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "manager": "Ava",
          "team_size": 3
        },
        {
          "manager": "Eve",
          "team_size": 2
        }
      ],
      "expectedHash": "2b44da8141dfd4564acf3f108df8163d233e0321196c3d1ad6d868c443978792"
    },
