{
  "id": "emp-second-highest-per-department",
  "number": 40,
  "title": "Second Highest Salary Per Department",
  "difficulty": "Hard",
  "tags": [
    "Window Function",
    "Ranking"
  ],
  "description": "For each department report the second highest **distinct** salary and everyone earning it. Departments without a second distinct salary produce no rows.\n\nName the columns `dept_id`, `name` and `salary`. Return the result in any order.",
  "solutionSql": "SELECT dept_id, name, salary\nFROM (\n  SELECT *, DENSE_RANK() OVER (PARTITION BY dept_id ORDER BY salary DESC) AS rnk\n  FROM employees\n  WHERE salary IS NOT NULL\n)\nWHERE rnk = 2;",
  "orderMatters": false,
  "hint": "DENSE_RANK numbers distinct salaries, so rank 2 is exactly the second distinct value — and it disappears on its own when there isn't one.",
  "outputExplanation": "In Engineering the second distinct salary tier is $120k (Ben and Cara). In Sales it is $85k (Gia). HR has only one distinct salary so there is no second tier.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "dept_id": 1,
          "name": "Ben",
          "salary": 120000
        },
        {
          "dept_id": 1,
          "name": "Cara",
          "salary": 120000
        },
        {
          "dept_id": 2,
          "name": "Gia",
          "salary": 85000
        }
      ],
      "expectedHash": "12c7c6e517145c7fb6b2e43a1c43b92379ec497459df161c364b062e61aa6a56"
