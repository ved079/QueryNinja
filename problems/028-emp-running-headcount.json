{
  "id": "emp-running-headcount",
  "number": 28,
  "title": "Running Headcount By Hire Date",
  "difficulty": "Medium",
  "tags": [
    "Window Function",
    "Date"
  ],
  "description": "Order employees by `hire_date` and report, for each hire, how many people had been hired up to and including that date.\n\nName the columns `hire_date`, `name` and `headcount`. Return the result in any order.",
  "solutionSql": "SELECT hire_date, name,\n       COUNT(*) OVER (ORDER BY hire_date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS headcount\nFROM employees;",
  "orderMatters": false,
  "hint": "A COUNT window with ORDER BY accumulates. Be explicit about the frame — ROWS and RANGE differ when dates tie.",
  "outputExplanation": "Eve was the first hire, Ava the second, Ben and Cara the third and fourth (same day), followed by Finn, Dan, Gia and Hal in order.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "hire_date": "2017-11-02",
          "name": "Eve",
          "headcount": 1
        },
        {
          "hire_date": "2018-01-15",
          "name": "Ava",
          "headcount": 2
        },
        {
          "hire_date": "2019-03-01",
          "name": "Ben",
          "headcount": 3
        },
        {
          "hire_date": "2019-03-01",
          "name": "Cara",
          "headcount": 4
        },
        {
          "hire_date": "2020-05-30",
          "name": "Finn",
          "headcount": 5
        },
        {
          "hire_date": "2021-07-19",
          "name": "Dan",
          "headcount": 6
        },
        {
          "hire_date": "2022-02-14",
          "name": "Gia",
          "headcount": 7
        },
        {
          "hire_date": "2023-09-01",
          "name": "Hal",
          "headcount": 8
        }
      ]
    },
