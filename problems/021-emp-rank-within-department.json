{
  "id": "emp-rank-within-department",
  "number": 21,
  "title": "Salary Rank Within Department",
  "difficulty": "Medium",
  "tags": [
    "Window Function",
    "Ranking"
  ],
  "description": "For every employee report their salary rank inside their own department, highest salary first. Employees on equal salaries share a rank and the next rank is **not** skipped.\n\nName the columns `name`, `dept_id` and `rnk`. Return the result in any order.",
  "solutionSql": "SELECT name, dept_id,\n       DENSE_RANK() OVER (PARTITION BY dept_id ORDER BY salary DESC) AS rnk\nFROM employees;",
  "orderMatters": false,
  "hint": "\"Ties share a rank and nothing is skipped\" is the definition of DENSE_RANK, as opposed to RANK.",
  "outputExplanation": "In Engineering, Ava is ranked 1st, Ben and Cara are tied at 2nd, and Dan is 3rd. In Sales, Eve is 1st, Gia is 2nd, and Finn is 3rd. Hal is the only employee in HR.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
