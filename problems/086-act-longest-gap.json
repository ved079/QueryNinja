{
  "id": "act-longest-gap",
  "number": 86,
  "title": "Longest Absence",
  "difficulty": "Hard",
  "tags": [
    "Window Function",
    "Date"
  ],
  "description": "For every user with two or more events, report the longest gap in whole days between two of their consecutive events, rounded to 2 decimals.\n\nName the columns `name` and `longest_gap_days`. Return the result in any order.",
  "solutionSql": "WITH gaps AS (\n  SELECT user_id,\n         JULIANDAY(event_time) - JULIANDAY(LAG(event_time) OVER (PARTITION BY user_id ORDER BY event_time, id)) AS gap\n  FROM events\n)\nSELECT u.name, ROUND(MAX(g.gap), 2) AS longest_gap_days\nFROM gaps g\nJOIN users u ON u.id = g.user_id\nWHERE g.gap IS NOT NULL\nGROUP BY u.id, u.name;",
  "orderMatters": false,
  "hint": "Filtering out the NULL gap (each user's first event) also removes single-event users automatically.",
  "outputExplanation": "Bo had the longest absence at 4.01 days between events. Ada's longest gap was 1.04 days and Cy's was 2.02 days.",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO users VALUES (1,'Ada','pro','2022-01-01'),(2,'Bo','free','2022-01-03'),(3,'Cy','pro','2022-02-10'),(4,'Di','free','2022-03-01');\nINSERT INTO events VALUES\n (1,1,'login','2022-03-01 09:00:00'),\n (2,1,'view','2022-03-01 09:05:00'),\n (3,1,'purchase','2022-03-01 09:40:00'),\n (4,1,'login','2022-03-02 10:00:00'),\n (5,1,'login','2022-03-03 11:00:00'),\n (6,2,'login','2022-03-01 08:00:00'),\n (7,2,'view','2022-03-05 08:10:00'),\n (8,3,'login','2022-03-02 20:00:00'),\n (9,3,'purchase','2022-03-02 20:30:00'),\n (10,3,'login','2022-03-04 21:00:00');",
      "expectedOutput": [
        {
          "name": "Ada",
          "longest_gap_days": 1.04
        },
        {
          "name": "Bo",
          "longest_gap_days": 4.01
        },
        {
          "name": "Cy",
          "longest_gap_days": 2.02
        }
      ]
    },
