{
  "id": "combine-two-tables",
  "number": 1,
  "title": "Combine Two Tables",
  "difficulty": "Easy",
  "tags": [
    "Join",
    "Left Join",
    "NULL Handling"
  ],
  "description": "Table `Person` holds people and table `Address` holds their addresses.\n\nWrite a query to report the `firstName`, `lastName`, `city` and `state` of every person. **If a person has no address recorded, still report them**, with `NULL` for `city` and `state`.\n\nReturn the result in any order.",
  "schemaSql": "CREATE TABLE Person (\n  personId INTEGER PRIMARY KEY,\n  lastName TEXT,\n  firstName TEXT\n);\n\nCREATE TABLE Address (\n  addressId INTEGER PRIMARY KEY,\n  personId INTEGER,\n  city TEXT,\n  state TEXT\n);",
  "solutionSql": "SELECT p.firstName, p.lastName, a.city, a.state\nFROM Person p\nLEFT JOIN Address a ON p.personId = a.personId;",
  "orderMatters": false,
  "hint": "A plain INNER JOIN would drop people with no address. Which join keeps every row from the left table?",
  "outputExplanation": "Each row of the result corresponds to one (person, address) pair. People without a matching address still appear once, with city and state set to NULL. People with multiple addresses appear once per address (fan-out).",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO Person VALUES (1,'Wang','Allen'),(2,'Alice','Bob'),(3,'Deo','Vedant');\nINSERT INTO Address VALUES (1,2,'New York City','New York'),(2,3,'Leetcode','California');",
      "expectedOutput": [
        {
          "firstName": "Allen",
          "lastName": "Wang",
          "city": null,
          "state": null
        },
        {
          "firstName": "Bob",
          "lastName": "Alice",
          "city": "New York City",
          "state": "New York"
        },
        {
          "firstName": "Vedant",
          "lastName": "Deo",
          "city": "Leetcode",
          "state": "California"
        }
      ],
      "expectedHash": "13de4cee3099d24fc09eb2cc9b44c6f7750932f894cd25f1b7d17b5d973c4d61"
    },
