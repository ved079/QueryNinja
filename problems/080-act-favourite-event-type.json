{
  "id": "act-favourite-event-type",
  "number": 80,
  "title": "Each User's Most Frequent Event",
  "difficulty": "Medium",
  "tags": [
    "Window Function",
    "Ranking"
  ],
  "description": "For every user report the event type they perform most often, together with the count. If a user ties across several types, report all of the tied types. Ignore events with a NULL type.\n\nName the columns `name`, `event_type` and `times`. Return the result in any order.",
  "solutionSql": "WITH counts AS (\n  SELECT u.name, e.event_type, COUNT(*) AS times,\n         RANK() OVER (PARTITION BY u.id ORDER BY COUNT(*) DESC) AS rnk\n  FROM users u\n  JOIN events e ON e.user_id = u.id\n  WHERE e.event_type IS NOT NULL\n  GROUP BY u.id, u.name, e.event_type\n)\nSELECT name, event_type, times FROM counts WHERE rnk = 1;",
  "orderMatters": false,
  "hint": "A window function may sit on top of a GROUP BY — RANK() OVER (... ORDER BY COUNT(*) DESC) ranks the groups themselves.",
  "outputExplanation": "Ada's most frequent event type is login (3 times). Bo's login and view are tied (1 each). Cy's most frequent is login (2 times).",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO users VALUES (1,'Ada','pro','2022-01-01'),(2,'Bo','free','2022-01-03'),(3,'Cy','pro','2022-02-10'),(4,'Di','free','2022-03-01');\nINSERT INTO events VALUES\n (1,1,'login','2022-03-01 09:00:00'),\n (2,1,'view','2022-03-01 09:05:00'),\n (3,1,'purchase','2022-03-01 09:40:00'),\n (4,1,'login','2022-03-02 10:00:00'),\n (5,1,'login','2022-03-03 11:00:00'),\n (6,2,'login','2022-03-01 08:00:00'),\n (7,2,'view','2022-03-05 08:10:00'),\n (8,3,'login','2022-03-02 20:00:00'),\n (9,3,'purchase','2022-03-02 20:30:00'),\n (10,3,'login','2022-03-04 21:00:00');",
      "expectedOutput": [
        {
          "name": "Ada",
          "event_type": "login",
          "times": 3
        },
        {
          "name": "Bo",
          "event_type": "login",
          "times": 1
        },
        {
          "name": "Bo",
          "event_type": "view",
          "times": 1
        },
        {
          "name": "Cy",
          "event_type": "login",
          "times": 2
        }
      ],
      "expectedHash": "a2b54277bf05d3d4370b1062445a2b40f950fe29a3cbfecdb15b247b2774a0f2"
    },
