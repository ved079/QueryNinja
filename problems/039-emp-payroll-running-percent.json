{
  "id": "emp-payroll-running-percent",
  "number": 39,
  "title": "Cumulative Share Of Payroll",
  "difficulty": "Hard",
  "tags": [
    "Window Function"
  ],
  "description": "Order employees by salary from highest to lowest (ties broken by `id`) and report the running percentage of total company payroll accounted for by everyone down to and including that employee, rounded to 2 decimals.\n\nName the columns `name`, `salary` and `running_pct`. Return the result in any order.",
  "solutionSql": "SELECT name, salary,\n       ROUND(100.0 * SUM(salary) OVER (ORDER BY salary DESC, id\n                                       ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)\n             / SUM(salary) OVER (), 2) AS running_pct\nFROM employees;",
  "orderMatters": false,
  "hint": "Two windows in one SELECT: a running SUM with a frame, divided by a grand-total SUM OVER () with no partition.",
  "outputExplanation": "Ava alone accounts for 18.07% of total payroll. By the time we reach Hal, 100% of payroll is covered. Each row shows the cumulative share from the highest earner down.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
