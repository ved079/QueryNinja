{
  "id": "emp-difference-from-department-average",
  "number": 35,
  "title": "Distance From Your Department's Average",
  "difficulty": "Medium",
  "tags": [
    "Window Function"
  ],
  "description": "For every employee report how far their salary sits above or below their department's average, rounded to 2 decimals. Negative means below average.\n\nName the columns `name` and `diff`. Return the result in any order.",
  "solutionSql": "SELECT name,\n       ROUND(salary - AVG(salary) OVER (PARTITION BY dept_id), 2) AS diff\nFROM employees;",
  "orderMatters": false,
  "hint": "Subtract the partitioned window average from the row's own salary.",
  "outputExplanation": "Ava earns $28,750 above Engineering's average, while Dan earns $26,250 below it. Eve earns $35k above Sales' average, and Finn earns $25k below. Hal is exactly at HR's average.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "name": "Ava",
          "diff": 28750
        },
        {
          "name": "Ben",
          "diff": -1250
        },
        {
          "name": "Cara",
          "diff": -1250
