      "seedSql": "INSERT INTO Logs VALUES (1,1),(2,1),(3,2),(4,2),(5,3),(6,3),(7,8),(8,8),(9,8);",
      "expectedOutput": [
        {"ConsecutiveNums": 8}
      ]
    },
    {
      "name": "Run of exactly three in the middle — not at either boundary",
      "seedSql": "INSERT INTO Logs VALUES (1,2),(2,2),(3,9),(4,9),(5,9),(6,3);",
      "expectedOutput": [
        {"ConsecutiveNums": 9}
      ]
    },
    {
      "name": "Ids inserted out of order — ORDER BY id, not insertion order",
      "seedSql": "INSERT INTO Logs VALUES (3,5),(1,5),(2,5),(6,1),(4,1),(5,1);",
