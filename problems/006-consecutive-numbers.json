      "seedSql": "INSERT INTO Logs VALUES (1,2147483647),(2,2147483647),(3,2147483647),(4,-2147483648),(5,-2147483648),(6,-2147483648),(7,0),(8,0);",
      "expectedOutput": [
        {"ConsecutiveNums": 2147483647},
        {"ConsecutiveNums": -2147483648}
