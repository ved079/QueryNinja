    {
      "name": "Stress test — 30 rows, scrambled ids, pairs, runs, and singletons",
      "seedSql": "INSERT INTO Logs VALUES (5,1),(3,1),(1,1),(2,2),(4,2),(6,3),(7,3),(8,3),(9,4),(10,4),(11,5),(12,5),(13,5),(14,5),(15,6),(16,6),(17,7),(18,7),(19,7),(20,8),(21,8),(22,9),(23,9),(24,9),(25,9),(26,9),(27,10),(28,10),(29,11),(30,11);",
      "expectedOutput": [
        {"ConsecutiveNums": 3},
