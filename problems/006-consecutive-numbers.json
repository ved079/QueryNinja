      "seedSql": "INSERT INTO Logs VALUES (1,1),(2,1),(3,1),(4,2),(5,2),(6,9),(7,9),(8,9);",
      "expectedOutput": [
        {"ConsecutiveNums": 1},
        {"ConsecutiveNums": 9}
      ]
