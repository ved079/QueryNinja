{
  "id": "consecutive-numbers",
  "number": 6,
  "title": "Consecutive Numbers",
  "difficulty": "Medium",
  "tags": [
    "Window Function",
    "Self Join"
  ],
  "description": "Table `Logs` has an auto-incrementing `id` with no gaps, and a `num` column.\n\nWrite a query to find all numbers that appear **at least three times in a row**. Name the output column `ConsecutiveNums`, and report each qualifying number only once.\n\nReturn the result in any order.",
  "schemaSql": "CREATE TABLE Logs (\n  id INTEGER PRIMARY KEY,\n  num INTEGER\n);",
  "solutionSql": "SELECT DISTINCT num AS ConsecutiveNums\nFROM (\n  SELECT num,\n         LAG(num, 1) OVER (ORDER BY id) AS prev1,\n         LAG(num, 2) OVER (ORDER BY id) AS prev2\n  FROM Logs\n)\nWHERE num = prev1 AND num = prev2;",
  "orderMatters": false,
  "hint": "LAG(num, 1) and LAG(num, 2) over ORDER BY id let you compare a row to the two before it. Don't forget DISTINCT — a number in two separate runs must still be reported once.",
  "outputExplanation": "The number 1 appears three times consecutively (ids 1–3), and the number 2 appears three times consecutively (ids 7–9). Both are reported once.",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO Logs VALUES (1,1),(2,1),(3,1),(4,2),(5,1),(6,2),(7,2),(8,2),(9,2);",
      "expectedOutput": [
        {
          "ConsecutiveNums": 1
        },
        {
          "ConsecutiveNums": 2
        }
      ],
      "expectedHash": "97aae4798576d35e470167921ed1ce5ab686a78cfcb2db4b1f63598d8532aa77"
    },
