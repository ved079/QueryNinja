{
  "id": "emp-share-of-department-payroll",
  "number": 23,
  "title": "Share Of Department Payroll",
  "difficulty": "Medium",
  "tags": [
    "Window Function"
  ],
  "description": "For every employee report what percentage of their department's total payroll their own salary represents, rounded to 2 decimal places.\n\nName the columns `name` and `pct_of_payroll`. Return the result in any order.",
  "solutionSql": "SELECT name,\n       ROUND(100.0 * salary / SUM(salary) OVER (PARTITION BY dept_id), 2) AS pct_of_payroll\nFROM employees;",
  "orderMatters": false,
  "hint": "SUM(...) OVER (PARTITION BY dept_id) keeps every row while giving it the department total. Multiply by 100.0, not 100, to avoid integer division.",
  "outputExplanation": "Ava accounts for 30.93% of Engineering's payroll, Ben and Cara each 24.74%, and Dan 19.59%. Eve makes up 45.61% of Sales' payroll, and Hal accounts for all of HR's.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
