{
  "id": "emp-salary-range-per-title",
  "number": 19,
  "title": "Salary Range Per Title",
  "difficulty": "Easy",
  "tags": [
    "Group By",
    "Aggregation"
  ],
  "description": "For each job title report the lowest and highest salary paid.\n\nName the columns `title`, `min_salary` and `max_salary`. Return the result in any order.",
  "solutionSql": "SELECT title, MIN(salary) AS min_salary, MAX(salary) AS max_salary\nFROM employees\nGROUP BY title;",
  "orderMatters": false,
  "hint": "Two aggregates over the same GROUP BY.",
  "outputExplanation": "Manager salaries range from $130k to $150k, Engineers from $95k to $120k, Reps from $70k to $85k, and the single Analyst earns $60k.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "title": "Analyst",
          "min_salary": 60000,
          "max_salary": 60000
        },
        {
          "title": "Engineer",
          "min_salary": 95000,
          "max_salary": 120000
        },
        {
          "title": "Manager",
          "min_salary": 130000,
          "max_salary": 150000
        },
        {
          "title": "Rep",
          "min_salary": 70000,
          "max_salary": 85000
        }
      ],
      "expectedHash": "9f8a6d8cbf44ce5019587a1af2a83111efad394b0ffb553ff76bfc3507803077"
    },
