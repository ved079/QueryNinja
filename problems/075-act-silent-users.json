{
  "id": "act-silent-users",
  "number": 75,
  "title": "Users Who Never Did Anything",
  "difficulty": "Medium",
  "tags": [
    "Anti Join"
  ],
  "description": "Report the `name` of every registered user with no events at all.\n\nName the column `name`. Return the result in any order.",
  "solutionSql": "SELECT u.name\nFROM users u\nWHERE NOT EXISTS (SELECT 1 FROM events e WHERE e.user_id = u.id);",
  "orderMatters": false,
  "hint": "NOT EXISTS is immune to the NULL trap that breaks NOT IN.",
  "outputExplanation": "Di is the only registered user with no events at all. Ada, Bo and Cy all have events.",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO users VALUES (1,'Ada','pro','2022-01-01'),(2,'Bo','free','2022-01-03'),(3,'Cy','pro','2022-02-10'),(4,'Di','free','2022-03-01');\nINSERT INTO events VALUES\n (1,1,'login','2022-03-01 09:00:00'),\n (2,1,'view','2022-03-01 09:05:00'),\n (3,1,'purchase','2022-03-01 09:40:00'),\n (4,1,'login','2022-03-02 10:00:00'),\n (5,1,'login','2022-03-03 11:00:00'),\n (6,2,'login','2022-03-01 08:00:00'),\n (7,2,'view','2022-03-05 08:10:00'),\n (8,3,'login','2022-03-02 20:00:00'),\n (9,3,'purchase','2022-03-02 20:30:00'),\n (10,3,'login','2022-03-04 21:00:00');",
      "expectedOutput": [
        {
          "name": "Di"
        }
      ],
      "expectedHash": "7b6250d6e81cc602a77eed0cdb4f6904e931b9ac2600056ed7f0843ce0ca8fea"
    },
    {
      "name": "A user with a long unbroken streak",
      "seedSql": "INSERT INTO users VALUES (1,'Streak','pro','2022-01-01'),(2,'Sparse','free','2022-01-01');\nINSERT INTO events VALUES\n (1,1,'login','2022-05-01 10:00:00'),\n (2,1,'login','2022-05-02 10:00:00'),\n (3,1,'login','2022-05-03 10:00:00'),\n (4,1,'login','2022-05-04 10:00:00'),\n (5,1,'login','2022-05-05 10:00:00'),\n (6,2,'login','2022-05-01 10:00:00'),\n (7,2,'login','2022-05-03 10:00:00'),\n (8,2,'login','2022-05-05 10:00:00');",
      "expectedOutput": [],
      "expectedHash": "ed1652f78cc4b15ad65fbd0712cf5c4f63a46706aae94b6e55ed1b13440fd075"
    },
