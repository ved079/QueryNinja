{
  "id": "act-three-day-streak",
  "number": 82,
  "title": "Active Three Days Running",
  "difficulty": "Hard",
  "tags": [
    "Gaps and Islands",
    "Window Function"
  ],
  "description": "Report the name of every user who was active on **three or more consecutive calendar days** at some point.\n\nName the column `name`. Return the result in any order.",
  "solutionSql": "WITH days AS (\n  SELECT DISTINCT user_id, DATE(event_time) AS d FROM events\n),\ngrouped AS (\n  SELECT user_id, DATE(d, '-' || ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY d) || ' day') AS grp\n  FROM days\n)\nSELECT DISTINCT u.name\nFROM grouped g\nJOIN users u ON u.id = g.user_id\nGROUP BY g.user_id, g.grp, u.name\nHAVING COUNT(*) >= 3;",
  "orderMatters": false,
  "hint": "Same islands trick as the longest streak, but you only need HAVING COUNT(*) >= 3 — and DISTINCT in case a user has several qualifying runs.",
  "outputExplanation": "Only Ada was active on three or more consecutive calendar days (March 1–3).",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO users VALUES (1,'Ada','pro','2022-01-01'),(2,'Bo','free','2022-01-03'),(3,'Cy','pro','2022-02-10'),(4,'Di','free','2022-03-01');\nINSERT INTO events VALUES\n (1,1,'login','2022-03-01 09:00:00'),\n (2,1,'view','2022-03-01 09:05:00'),\n (3,1,'purchase','2022-03-01 09:40:00'),\n (4,1,'login','2022-03-02 10:00:00'),\n (5,1,'login','2022-03-03 11:00:00'),\n (6,2,'login','2022-03-01 08:00:00'),\n (7,2,'view','2022-03-05 08:10:00'),\n (8,3,'login','2022-03-02 20:00:00'),\n (9,3,'purchase','2022-03-02 20:30:00'),\n (10,3,'login','2022-03-04 21:00:00');",
      "expectedOutput": [
        {
          "name": "Ada"
        }
      ],
      "expectedHash": "d43e3ee8510d7d250479d1daad698c3d22c1fa248927320df8b86fc266320a8e"
    },
