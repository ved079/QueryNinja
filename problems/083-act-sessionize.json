{
  "id": "act-sessionize",
  "number": 83,
  "title": "Count Sessions With A 30-Minute Timeout",
  "difficulty": "Hard",
  "tags": [
    "Window Function",
    "Sessionization"
  ],
  "description": "A user's session ends after 30 minutes of inactivity: an event starts a new session if it is their first, or if more than 30 minutes passed since their previous event.\n\nReport how many sessions each user with events had.\n\nName the columns `name` and `sessions`. Return the result in any order.",
  "solutionSql": "WITH gaps AS (\n  SELECT user_id,\n         CASE WHEN LAG(event_time) OVER (PARTITION BY user_id ORDER BY event_time, id) IS NULL\n                OR (JULIANDAY(event_time) - JULIANDAY(LAG(event_time) OVER (PARTITION BY user_id ORDER BY event_time, id))) * 24 * 60 > 30\n              THEN 1 ELSE 0 END AS is_new\n  FROM events\n)\nSELECT u.name, SUM(g.is_new) AS sessions\nFROM gaps g\nJOIN users u ON u.id = g.user_id\nGROUP BY u.id, u.name;",
  "orderMatters": false,
  "hint": "Flag each event as starting a session or not, then simply add the flags up.",
  "outputExplanation": "Ada had 4 sessions, Bo had 2 and Cy had 2, based on a 30-minute inactivity timeout.",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO users VALUES (1,'Ada','pro','2022-01-01'),(2,'Bo','free','2022-01-03'),(3,'Cy','pro','2022-02-10'),(4,'Di','free','2022-03-01');\nINSERT INTO events VALUES\n (1,1,'login','2022-03-01 09:00:00'),\n (2,1,'view','2022-03-01 09:05:00'),\n (3,1,'purchase','2022-03-01 09:40:00'),\n (4,1,'login','2022-03-02 10:00:00'),\n (5,1,'login','2022-03-03 11:00:00'),\n (6,2,'login','2022-03-01 08:00:00'),\n (7,2,'view','2022-03-05 08:10:00'),\n (8,3,'login','2022-03-02 20:00:00'),\n (9,3,'purchase','2022-03-02 20:30:00'),\n (10,3,'login','2022-03-04 21:00:00');",
      "expectedOutput": [
