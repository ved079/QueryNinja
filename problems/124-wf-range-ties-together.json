{
  "id": "wf-range-ties-together",
  "number": 124,
  "title": "Cumulative Hires, Counting Same-Day Hires Together",
  "difficulty": "Medium",
  "tags": [
    "Window Function"
  ],
  "description": "Report a running count of employees hired up to and including each hire date — but if several employees were hired on the **same date**, they must all show the same cumulative count (the count as of that whole date, not partway through it).\n\nName the columns `name`, `hire_date` and `hires_so_far`. Return the result in any order.",
  "solutionSql": "SELECT name, hire_date,\n  COUNT(*) OVER (ORDER BY hire_date RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS hires_so_far\nFROM employees;",
  "orderMatters": false,
  "hint": "This is the real difference between RANGE and ROWS: ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW counts physical rows up to this one, so two people hired the same day would get *different* counts depending on row order. RANGE treats every row with an equal ORDER BY value as one \"peer group\" and gives them all the same result.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
