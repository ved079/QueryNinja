{
  "id": "wf-salary-thirds",
  "number": 123,
  "title": "Split Employees Into Salary Thirds",
  "difficulty": "Easy",
  "tags": [
    "Window Function"
  ],
  "description": "Order all employees by salary and split them into 3 roughly equal-sized groups (lowest-paid third, middle third, highest-paid third).\n\nName the columns `name` and `salary_third` (1, 2 or 3). Return the result in any order.",
  "solutionSql": "SELECT name, NTILE(3) OVER (ORDER BY salary, id) AS salary_third\nFROM employees;",
  "orderMatters": false,
  "hint": "NTILE(n) just numbers the rows into n as-equal-as-possible buckets in ORDER BY order — it has nothing to do with the salary values themselves, only their rank.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
