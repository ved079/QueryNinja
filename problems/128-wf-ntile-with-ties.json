{
  "id": "wf-ntile-with-ties",
  "number": 128,
  "title": "Salary Quartiles When Many Salaries Tie",
  "difficulty": "Hard",
  "tags": [
    "Window Function"
  ],
  "description": "Split all employees into 4 salary quartiles using `NTILE(4)`. Several employees may share the exact same salary — order by salary, then by `id` to keep the split deterministic.\n\nName the columns `name` and `quartile`. Return the result in any order.",
  "solutionSql": "SELECT name, NTILE(4) OVER (ORDER BY salary, id) AS quartile\nFROM employees;",
  "orderMatters": false,
  "hint": "NTILE does not know or care that several rows are tied on salary — it splits strictly by row position in ORDER BY order. Two employees earning the identical salary can easily land in different quartiles. Without a tie-breaker like `id`, which one gets which quartile isn't even well-defined.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "name": "Hal",
          "quartile": 1
        },
        {
          "name": "Finn",
          "quartile": 1
        },
        {
          "name": "Gia",
          "quartile": 2
        },
        {
          "name": "Dan",
          "quartile": 2
        },
        {
          "name": "Ben",
          "quartile": 3
        },
        {
          "name": "Cara",
          "quartile": 3
        },
        {
          "name": "Eve",
          "quartile": 4
        },
        {
          "name": "Ava",
          "quartile": 4
        }
      ],
      "expectedHash": "13510d18a82d2ea4d46e84e959bb8be3ec11576696c5fbc0717fa719a2104ff2"
    },
