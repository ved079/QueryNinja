{
  "id": "emp-high-earners",
  "number": 8,
  "title": "Six-Figure Employees",
  "difficulty": "Easy",
  "tags": [
    "Filtering"
  ],
  "description": "Report the `name` and `salary` of every employee earning **more than 100000**.\n\nName the columns `name` and `salary`. Return the result in any order.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "solutionSql": "SELECT name, salary FROM employees WHERE salary > 100000;",
  "orderMatters": false,
  "hint": "A plain WHERE filter. Remember that comparisons against NULL are never true — a NULL salary is not > 100000.",
  "outputExplanation": "Ava ($150k), Ben ($120k), Cara ($120k) and Eve ($130k) earn more than $100,000. Dan, Finn, Gia and Hal earn $100k or less.",
  "tests": [
