{
  "id": "act-purchased-on-first-day",
  "number": 79,
  "title": "Bought On Day One",
  "difficulty": "Medium",
  "tags": [
    "Subquery",
    "Date"
  ],
  "description": "Report the name of every user who made a purchase on the same calendar day as their very first event.\n\nName the column `name`. Return the result in any order.",
  "solutionSql": "SELECT DISTINCT u.name\nFROM users u\nJOIN events e ON e.user_id = u.id\nWHERE e.event_type = 'purchase'\n  AND DATE(e.event_time) = (SELECT DATE(MIN(event_time)) FROM events x WHERE x.user_id = u.id);",
  "orderMatters": false,
  "hint": "A correlated subquery finds each user's own first event date; compare the purchase's date against it.",
  "outputExplanation": "Ada and Cy both made a purchase on the same calendar day as their first event. Bo never made a purchase.",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO users VALUES (1,'Ada','pro','2022-01-01'),(2,'Bo','free','2022-01-03'),(3,'Cy','pro','2022-02-10'),(4,'Di','free','2022-03-01');\nINSERT INTO events VALUES\n (1,1,'login','2022-03-01 09:00:00'),\n (2,1,'view','2022-03-01 09:05:00'),\n (3,1,'purchase','2022-03-01 09:40:00'),\n (4,1,'login','2022-03-02 10:00:00'),\n (5,1,'login','2022-03-03 11:00:00'),\n (6,2,'login','2022-03-01 08:00:00'),\n (7,2,'view','2022-03-05 08:10:00'),\n (8,3,'login','2022-03-02 20:00:00'),\n (9,3,'purchase','2022-03-02 20:30:00'),\n (10,3,'login','2022-03-04 21:00:00');",
      "expectedOutput": [
        {
          "name": "Ada"
        },
        {
          "name": "Cy"
        }
      ],
      "expectedHash": "7f21c7ce3dd237c3b199d19d6be314ab7d72f10cc1c127e8bd8be08763bb4180"
    },
