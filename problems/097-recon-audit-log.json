{
  "id": "recon-audit-log",
  "number": 97,
  "title": "Build An Audit Log Of Both Systems",
  "difficulty": "Medium",
  "tags": [
    "Set Operations"
  ],
  "description": "Build a combined audit log listing every row from `source_orders` and every row from `warehouse_orders`, tagged with which system it came from. Unlike the reconciliation queries above, **duplicate rows must be preserved** here — if source has the same order twice, the log should show it twice.\n\nName the columns `order_id`, `customer_name`, `amount` and `system` (`source` or `warehouse`). Return the result in any order.",
  "solutionSql": "SELECT order_id, customer_name, amount, 'source' AS system FROM source_orders\nUNION ALL\nSELECT order_id, customer_name, amount, 'warehouse' AS system FROM warehouse_orders;",
  "orderMatters": false,
  "hint": "This is exactly the case UNION ALL exists for — an audit log should never silently drop a real duplicate row the way UNION would.",
  "outputExplanation": "The audit log contains all 4 source rows (tagged 'source') and all 3 warehouse rows (tagged 'warehouse'), for 7 rows total. Orders 1 and 2 appear twice — once from each system.",
  "schemaSql": "CREATE TABLE source_orders (\n  order_id INTEGER,\n  customer_name TEXT,\n  amount REAL\n);\n\nCREATE TABLE warehouse_orders (\n  order_id INTEGER,\n  customer_name TEXT,\n  amount REAL\n);\n\nCREATE TABLE vendor_orders (\n  order_id INTEGER,\n  customer_name TEXT,\n  amount REAL\n);",
  "tests": [
