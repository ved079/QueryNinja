{
  "id": "emp-top-earner-per-department",
  "number": 25,
  "title": "Top Earner Of Each Department",
  "difficulty": "Medium",
  "tags": [
    "Window Function",
    "Join"
  ],
  "description": "Report the highest-paid employee of each department. If several employees tie for the top salary, report all of them.\n\nName the columns `department`, `name` and `salary`. Return the result in any order.",
  "solutionSql": "SELECT d.name AS department, e.name, e.salary\nFROM (\n  SELECT *, RANK() OVER (PARTITION BY dept_id ORDER BY salary DESC) AS rnk\n  FROM employees\n) e\nJOIN departments d ON d.id = e.dept_id\nWHERE e.rnk = 1;",
  "orderMatters": false,
  "hint": "Rank inside each department, then keep rank 1 — ties come along for free.",
  "outputExplanation": "Ava ($150k) is the top earner in Engineering, Eve ($130k) in Sales, and Hal ($60k) in HR.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "department": "Engineering",
          "name": "Ava",
          "salary": 150000
        },
        {
          "department": "Sales",
          "name": "Eve",
          "salary": 130000
        },
        {
          "department": "HR",
          "name": "Hal",
          "salary": 60000
        }
      ],
      "expectedHash": "94a85019c7c578753bb3cb69d6ddc36c269aeae4ecdfe9184a97dbd41a9e3ce9"
    },
