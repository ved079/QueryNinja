{
  "id": "act-daily-active-users",
  "number": 74,
  "title": "Daily Active Users",
  "difficulty": "Medium",
  "tags": [
    "Date",
    "Distinct"
  ],
  "description": "For each calendar day on which anything happened, report how many distinct users were active.\n\nName the columns `day` and `active_users`. Return the result in any order.",
  "solutionSql": "SELECT DATE(event_time) AS day, COUNT(DISTINCT user_id) AS active_users\nFROM events\nGROUP BY day;",
  "orderMatters": false,
  "hint": "DATE() strips the time part off a timestamp. Count DISTINCT users, not rows.",
  "outputExplanation": "March 1 and 2 each had 2 active users. March 3, 4 and 5 each had 1 active user.",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO users VALUES (1,'Ada','pro','2022-01-01'),(2,'Bo','free','2022-01-03'),(3,'Cy','pro','2022-02-10'),(4,'Di','free','2022-03-01');\nINSERT INTO events VALUES\n (1,1,'login','2022-03-01 09:00:00'),\n (2,1,'view','2022-03-01 09:05:00'),\n (3,1,'purchase','2022-03-01 09:40:00'),\n (4,1,'login','2022-03-02 10:00:00'),\n (5,1,'login','2022-03-03 11:00:00'),\n (6,2,'login','2022-03-01 08:00:00'),\n (7,2,'view','2022-03-05 08:10:00'),\n (8,3,'login','2022-03-02 20:00:00'),\n (9,3,'purchase','2022-03-02 20:30:00'),\n (10,3,'login','2022-03-04 21:00:00');",
      "expectedOutput": [
        {
          "day": "2022-03-01",
          "active_users": 2
        },
        {
          "day": "2022-03-02",
          "active_users": 2
        },
        {
          "day": "2022-03-03",
          "active_users": 1
        },
        {
          "day": "2022-03-04",
          "active_users": 1
        },
        {
          "day": "2022-03-05",
          "active_users": 1
        }
      ],
      "expectedHash": "114169bf8f562f6fd1c328a8b20a1119db0be7e82b397e63b4ad2ec1cdd5c094"
    },
