{
  "id": "wf-trailing-average-explicit",
  "number": 126,
  "title": "Trailing 3-Hire Average, Explicit Bounds",
  "difficulty": "Medium",
  "tags": [
    "Window Function"
  ],
  "description": "Order employees by hire date. For each one, report the average salary across **themselves and the two people hired immediately before them** (fewer than 3 for the first couple of hires is fine — average over whatever's available).\n\nName the columns `name` and `trailing_avg` (rounded to 2 decimals). Return the result in any order.",
  "solutionSql": "SELECT name,\n  ROUND(AVG(salary) OVER (ORDER BY hire_date, id ROWS BETWEEN 2 PRECEDING AND CURRENT ROW), 2) AS trailing_avg\nFROM employees;",
  "orderMatters": false,
  "hint": "Contrast with the centered-average problem: this one only looks backward (`2 PRECEDING AND CURRENT ROW`), never forward — a genuinely trailing window, the kind you'd use for a running average you could compute in real time as hires happen.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "name": "Eve",
          "trailing_avg": 130000
        },
        {
          "name": "Ava",
          "trailing_avg": 140000
        },
        {
          "name": "Ben",
          "trailing_avg": 133333.33
        },
        {
