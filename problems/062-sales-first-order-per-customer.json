{
  "id": "sales-first-order-per-customer",
  "number": 62,
  "title": "Each Customer's First Order",
  "difficulty": "Medium",
  "tags": [
    "Window Function"
  ],
  "description": "For every customer who has ordered, report the date of their earliest order. If two orders share that earliest date, report the row with the smaller order id.\n\nName the columns `customer` and `first_order`. Return the result in any order.",
  "solutionSql": "SELECT c.name AS customer, o.order_date AS first_order\nFROM (\n  SELECT *, ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY order_date, id) AS rn\n  FROM orders\n) o\nJOIN customers c ON c.id = o.customer_id\nWHERE o.rn = 1;",
  "orderMatters": false,
  "hint": "ROW_NUMBER with a tie-breaker in the ORDER BY guarantees exactly one row per customer.",
  "outputExplanation": "Ada's first order was on 2022-01-10, Bo's on 2022-02-20, and Cy's on 2022-03-05. Di has never ordered.",
  "schemaSql": "CREATE TABLE customers (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  country TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE products (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  category TEXT,\n  price REAL\n);\n\nCREATE TABLE orders (\n  id INTEGER PRIMARY KEY,\n  customer_id INTEGER,\n  order_date TEXT,\n  status TEXT\n);\n\nCREATE TABLE order_items (\n  id INTEGER PRIMARY KEY,\n  order_id INTEGER,\n  product_id INTEGER,\n  quantity INTEGER,\n  unit_price REAL\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO customers VALUES (1,'Ada','US','2021-01-05'),(2,'Bo','UK','2021-03-12'),(3,'Cy','US','2022-06-30'),(4,'Di','IN','2022-11-01');\nINSERT INTO products VALUES (1,'Keyboard','Tech',80.0),(2,'Mouse','Tech',25.0),(3,'Desk','Furniture',300.0),(4,'Lamp','Furniture',45.0);\nINSERT INTO orders VALUES (1,1,'2022-01-10','completed'),(2,1,'2022-02-14','completed'),(3,2,'2022-02-20','cancelled'),(4,3,'2022-03-05','completed'),(5,3,'2022-03-06','pending'),(6,1,'2023-01-02','completed');\nINSERT INTO order_items VALUES (1,1,1,2,80.0),(2,1,2,1,25.0),(3,2,3,1,300.0),(4,3,4,4,45.0),(5,4,2,3,25.0),(6,5,1,1,80.0),(7,6,4,2,45.0),(8,6,2,2,25.0);",
      "expectedOutput": [
        {
          "customer": "Ada",
          "first_order": "2022-01-10"
        },
        {
          "customer": "Bo",
          "first_order": "2022-02-20"
        },
        {
          "customer": "Cy",
          "first_order": "2022-03-05"
        }
      ],
      "expectedHash": "25b13dd8ad3bd0078a233c86f8d6f46fe8bb2432729e8315cb16f8d8e15f93c7"
    },
