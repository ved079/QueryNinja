{
  "id": "act-median-events-per-user",
  "number": 90,
  "title": "Median Events Per User",
  "difficulty": "Hard",
  "tags": [
    "Statistics",
    "Subquery"
  ],
  "description": "Considering only users who have at least one event, report the median number of events per user.\n\nName the column `median_events`. The result is exactly one row.",
  "solutionSql": "WITH per_user AS (\n  SELECT user_id, COUNT(*) AS n FROM events GROUP BY user_id\n)\nSELECT AVG(n) AS median_events FROM (\n  SELECT n FROM per_user\n  ORDER BY n\n  LIMIT 2 - (SELECT COUNT(*) FROM per_user) % 2\n  OFFSET (SELECT (COUNT(*) - 1) / 2 FROM per_user)\n);",
  "orderMatters": false,
  "hint": "Same median recipe as before, applied to per-user counts rather than raw values.",
  "outputExplanation": "With event counts of 2, 3 and 5, the median number of events per active user is 3.",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO users VALUES (1,'Ada','pro','2022-01-01'),(2,'Bo','free','2022-01-03'),(3,'Cy','pro','2022-02-10'),(4,'Di','free','2022-03-01');\nINSERT INTO events VALUES\n (1,1,'login','2022-03-01 09:00:00'),\n (2,1,'view','2022-03-01 09:05:00'),\n (3,1,'purchase','2022-03-01 09:40:00'),\n (4,1,'login','2022-03-02 10:00:00'),\n (5,1,'login','2022-03-03 11:00:00'),\n (6,2,'login','2022-03-01 08:00:00'),\n (7,2,'view','2022-03-05 08:10:00'),\n (8,3,'login','2022-03-02 20:00:00'),\n (9,3,'purchase','2022-03-02 20:30:00'),\n (10,3,'login','2022-03-04 21:00:00');",
      "expectedOutput": [
        {
          "median_events": 3
        }
      ]
    },
    {
      "name": "A user with a long unbroken streak",
