{
  "id": "act-event-type-pivot",
  "number": 77,
  "title": "Pivot Events Into Columns",
  "difficulty": "Medium",
  "tags": [
    "CASE",
    "Pivot"
  ],
  "description": "For every user with events, report how many logins, views and purchases they have — one row per user, three columns.\n\nName the columns `name`, `logins`, `views` and `purchases`. Return the result in any order.",
  "solutionSql": "SELECT u.name,\n       SUM(CASE WHEN e.event_type = 'login' THEN 1 ELSE 0 END) AS logins,\n       SUM(CASE WHEN e.event_type = 'view' THEN 1 ELSE 0 END) AS views,\n       SUM(CASE WHEN e.event_type = 'purchase' THEN 1 ELSE 0 END) AS purchases\nFROM users u\nJOIN events e ON e.user_id = u.id\nGROUP BY u.id, u.name;",
  "orderMatters": false,
  "hint": "SQL has no PIVOT here — conditional aggregation with CASE inside SUM does the same job.",
  "outputExplanation": "Ada: 3 logins, 1 view, 1 purchase. Bo: 1 login, 1 view, 0 purchases. Cy: 2 logins, 0 views, 1 purchase.",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO users VALUES (1,'Ada','pro','2022-01-01'),(2,'Bo','free','2022-01-03'),(3,'Cy','pro','2022-02-10'),(4,'Di','free','2022-03-01');\nINSERT INTO events VALUES\n (1,1,'login','2022-03-01 09:00:00'),\n (2,1,'view','2022-03-01 09:05:00'),\n (3,1,'purchase','2022-03-01 09:40:00'),\n (4,1,'login','2022-03-02 10:00:00'),\n (5,1,'login','2022-03-03 11:00:00'),\n (6,2,'login','2022-03-01 08:00:00'),\n (7,2,'view','2022-03-05 08:10:00'),\n (8,3,'login','2022-03-02 20:00:00'),\n (9,3,'purchase','2022-03-02 20:30:00'),\n (10,3,'login','2022-03-04 21:00:00');",
      "expectedOutput": [
        {
          "name": "Ada",
          "logins": 3,
          "views": 1,
          "purchases": 1
        },
        {
          "name": "Bo",
          "logins": 1,
          "views": 1,
          "purchases": 0
        },
        {
          "name": "Cy",
          "logins": 2,
          "views": 0,
          "purchases": 1
        }
      ]
    },
