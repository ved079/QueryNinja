{
  "id": "emp-salary-percentile",
  "number": 43,
  "title": "Salary Percentile Rank",
  "difficulty": "Hard",
  "tags": [
    "Window Function",
    "Statistics"
  ],
  "description": "For every employee with a salary, report their percentile rank in the company — the fraction of employees earning strictly less than them, as a percentage rounded to 2 decimals.\n\nName the columns `name` and `percentile`. Return the result in any order.",
  "solutionSql": "SELECT name,\n       ROUND(100.0 * (COUNT(*) OVER (ORDER BY salary RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)\n                      - COUNT(*) OVER (PARTITION BY salary))\n             / COUNT(*) OVER (), 2) AS percentile\nFROM employees\nWHERE salary IS NOT NULL;",
  "orderMatters": false,
  "hint": "A RANGE frame counts every row with an equal salary, so subtract the size of the tie group to get \"strictly less than\".",
  "outputExplanation": "Hal (0%) is the lowest paid, Finn (12.5%) is next, and Ava (87.5%) is the highest. Ben and Cara are tied at the 50th percentile.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "name": "Hal",
          "percentile": 0
        },
        {
          "name": "Finn",
          "percentile": 12.5
        },
        {
          "name": "Gia",
          "percentile": 25
        },
        {
          "name": "Dan",
          "percentile": 37.5
        },
        {
          "name": "Ben",
          "percentile": 50
        },
        {
          "name": "Cara",
          "percentile": 50
        },
        {
          "name": "Eve",
          "percentile": 75
        },
        {
          "name": "Ava",
          "percentile": 87.5
        }
      ],
      "expectedHash": "7600c69564ff4c453dfbecf4082fa278a7cedb7f2ea5a6ec47b7915cecce7171"
    },
