{
  "id": "str-fiscal-year-label",
  "number": 114,
  "title": "Fiscal Year Labels (Year Starts In April)",
  "difficulty": "Medium",
  "tags": [
    "Date"
  ],
  "description": "This company's fiscal year runs from **April 1st to March 31st** — so a hire on 2022-01-15 belongs to fiscal year `FY2021`, not `FY2022`. Report every employee's `name` and their fiscal year label.\n\nName the columns `name` and `fiscal_year`. Return the result in any order.",
  "solutionSql": "SELECT name,\n  'FY' || (CASE\n    WHEN CAST(strftime('%m', hire_date) AS INTEGER) >= 4 THEN CAST(strftime('%Y', hire_date) AS INTEGER)\n    ELSE CAST(strftime('%Y', hire_date) AS INTEGER) - 1\n  END) AS fiscal_year\nFROM employees;",
  "orderMatters": false,
  "hint": "January through March belong to the *previous* calendar year's fiscal year — the classic off-by-one this kind of bucketing trips people up on.",
  "outputExplanation": "Ava (Jan 2018) gets FY2017, Ben and Cara (Mar 2019) get FY2018, Gia (Feb 2022) gets FY2021 — all hired before April roll back one fiscal year. Dan (Jul 2021) and Eve (Nov 2017) stay in their calendar year's FY.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "name": "Ava",
          "fiscal_year": "FY2017"
        },
        {
          "name": "Ben",
          "fiscal_year": "FY2018"
        },
        {
          "name": "Cara",
          "fiscal_year": "FY2018"
        },
        {
          "name": "Dan",
          "fiscal_year": "FY2021"
