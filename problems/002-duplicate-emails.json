{
  "id": "duplicate-emails",
  "number": 2,
  "title": "Duplicate Emails",
  "difficulty": "Easy",
  "tags": [
    "Group By",
    "Having",
    "String Comparison"
  ],
  "description": "Table `Person` stores one row per signup, and `email` is not guaranteed unique.\n\nWrite a query to report all emails that appear **more than once**. Name the output column `Email`.\n\nReturn the result in any order.",
  "schemaSql": "CREATE TABLE Person (\n  id INTEGER PRIMARY KEY,\n  email TEXT NOT NULL\n);",
  "solutionSql": "SELECT email AS Email\nFROM Person\nGROUP BY email\nHAVING COUNT(*) > 1;",
  "orderMatters": false,
  "hint": "WHERE filters rows before grouping; you need a filter that runs *after* the group is formed.",
  "outputExplanation": "Each row of the result is one email whose total row count in `Person` exceeds 1. The output column is aliased as `Email`. Each qualifying email appears exactly once in the output regardless of how many times it occurs in the input.",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO Person VALUES (1,'a@b.com'),(2,'c@d.com'),(3,'a@b.com'),(4,'e@f.com'),(5,'c@d.com'),(6,'a@b.com');",
      "expectedOutput": [
        {
          "Email": "a@b.com"
        },
        {
          "Email": "c@d.com"
        }
      ],
      "expectedHash": "08d081b0850fcb9136ef4223d833c3d5342d4dc3b19293b697334f5e9285ea5c"
    },
    {
      "name": "All emails are unique",
      "seedSql": "INSERT INTO Person VALUES (1,'a@x.com'),(2,'b@x.com'),(3,'c@x.com');",
      "expectedOutput": [],
      "expectedHash": "ed1652f78cc4b15ad65fbd0712cf5c4f63a46706aae94b6e55ed1b13440fd075"
    },
    {
      "name": "Every row is the same email",
