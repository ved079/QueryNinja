{
  "id": "wf-lag-with-default",
  "number": 127,
  "title": "Salary Two Hires Before, With A Default",
  "difficulty": "Medium",
  "tags": [
    "Window Function"
  ],
  "description": "Within each department, order employees by hire date. For each one, report the salary of the person hired **two hires before them** in that same department. If there isn't one (too early in the department's history), report `0` instead of `NULL`.\n\nName the columns `name` and `salary_two_hires_ago`. Return the result in any order.",
  "solutionSql": "SELECT name,\n  LAG(salary, 2, 0) OVER (PARTITION BY dept_id ORDER BY hire_date, id) AS salary_two_hires_ago\nFROM employees;",
  "orderMatters": false,
  "hint": "LAG takes three arguments: the column, how many rows back, and a default to use instead of NULL when that row doesn't exist — most people only ever use the first argument.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
