{
  "id": "act-time-between-events",
  "number": 78,
  "title": "Minutes Since Your Last Event",
  "difficulty": "Medium",
  "tags": [
    "Window Function",
    "Date"
  ],
  "description": "For every event report how many minutes passed since that user's previous event, rounded to 2 decimals. A user's first event reports NULL.\n\nName the columns `id`, `user_id` and `minutes_since_prev`. Return the result in any order.",
  "solutionSql": "SELECT id, user_id,\n       ROUND((JULIANDAY(event_time) - JULIANDAY(LAG(event_time) OVER (PARTITION BY user_id ORDER BY event_time, id))) * 24 * 60, 2) AS minutes_since_prev\nFROM events;",
  "orderMatters": false,
  "hint": "JULIANDAY returns days as a float — multiply the difference by 24*60 for minutes.",
  "outputExplanation": "Each user's first event has NULL minutes since previous. Subsequent gaps range from 5 minutes to over 4 days.",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
