{
  "id": "emp-manager-chain-names",
  "number": 41,
  "title": "Print The Reporting Line",
  "difficulty": "Hard",
  "tags": [
    "Recursive CTE",
    "String"
  ],
  "description": "For every employee report their full reporting line from the top of the company down to them, as a single string joined by ` > `. For example an engineer under a manager under a CEO reads `CEO > Manager > Engineer` (using their names).\n\nName the columns `name` and `chain`. Return the result in any order.",
  "solutionSql": "WITH RECURSIVE line(id, name, chain) AS (\n  SELECT id, name, name FROM employees WHERE manager_id IS NULL\n  UNION ALL\n  SELECT e.id, e.name, l.chain || ' > ' || e.name\n  FROM employees e\n  JOIN line l ON e.manager_id = l.id\n)\nSELECT name, chain FROM line;",
  "orderMatters": false,
  "hint": "Carry the accumulated string down the recursion, appending with the || operator.",
  "outputExplanation": "Ava, Eve and Hal are top-level and appear alone. Ben, Cara and Dan fall under Ava. Finn and Gia fall under Eve.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "name": "Ava",
          "chain": "Ava"
        },
        {
          "name": "Eve",
          "chain": "Eve"
        },
        {
          "name": "Hal",
          "chain": "Hal"
        },
        {
          "name": "Ben",
          "chain": "Ava > Ben"
        },
        {
          "name": "Cara",
          "chain": "Ava > Cara"
        },
        {
          "name": "Dan",
          "chain": "Ava > Dan"
        },
        {
          "name": "Finn",
          "chain": "Eve > Finn"
        },
        {
          "name": "Gia",
          "chain": "Eve > Gia"
        }
      ]
