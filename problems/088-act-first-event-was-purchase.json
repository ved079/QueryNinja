{
  "id": "act-first-event-was-purchase",
  "number": 88,
  "title": "Started With A Purchase",
  "difficulty": "Hard",
  "tags": [
    "Window Function"
  ],
  "description": "Report the name of every user whose very first event (earliest timestamp, ties broken by the smaller event `id`) was a purchase.\n\nName the column `name`. Return the result in any order.",
  "solutionSql": "WITH ordered AS (\n  SELECT user_id, event_type,\n         ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY event_time, id) AS rn\n  FROM events\n)\nSELECT u.name\nFROM ordered o\nJOIN users u ON u.id = o.user_id\nWHERE o.rn = 1 AND o.event_type = 'purchase';",
  "orderMatters": false,
  "hint": "When timestamps tie, the ORDER BY inside ROW_NUMBER needs a tie-breaker or the answer is not deterministic.",
  "outputExplanation": "No user in the example data started with a purchase. A hidden test with purchase-only events demonstrates this case.",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO users VALUES (1,'Ada','pro','2022-01-01'),(2,'Bo','free','2022-01-03'),(3,'Cy','pro','2022-02-10'),(4,'Di','free','2022-03-01');\nINSERT INTO events VALUES\n (1,1,'login','2022-03-01 09:00:00'),\n (2,1,'view','2022-03-01 09:05:00'),\n (3,1,'purchase','2022-03-01 09:40:00'),\n (4,1,'login','2022-03-02 10:00:00'),\n (5,1,'login','2022-03-03 11:00:00'),\n (6,2,'login','2022-03-01 08:00:00'),\n (7,2,'view','2022-03-05 08:10:00'),\n (8,3,'login','2022-03-02 20:00:00'),\n (9,3,'purchase','2022-03-02 20:30:00'),\n (10,3,'login','2022-03-04 21:00:00');",
      "expectedOutput": [],
      "expectedHash": "ed1652f78cc4b15ad65fbd0712cf5c4f63a46706aae94b6e55ed1b13440fd075"
