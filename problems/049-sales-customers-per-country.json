{
  "id": "sales-customers-per-country",
  "number": 49,
  "title": "Customers Per Country",
  "difficulty": "Easy",
  "tags": [
    "Group By"
  ],
  "description": "Report how many customers signed up from each country.\n\nName the columns `country` and `customers`. Return the result in any order.",
  "solutionSql": "SELECT country, COUNT(*) AS customers FROM customers GROUP BY country;",
  "orderMatters": false,
  "hint": "One row per distinct country, including the NULL group.",
  "outputExplanation": "Two customers are from the US, one from the UK and one from India.",
  "schemaSql": "CREATE TABLE customers (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  country TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE products (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  category TEXT,\n  price REAL\n);\n\nCREATE TABLE orders (\n  id INTEGER PRIMARY KEY,\n  customer_id INTEGER,\n  order_date TEXT,\n  status TEXT\n);\n\nCREATE TABLE order_items (\n  id INTEGER PRIMARY KEY,\n  order_id INTEGER,\n  product_id INTEGER,\n  quantity INTEGER,\n  unit_price REAL\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO customers VALUES (1,'Ada','US','2021-01-05'),(2,'Bo','UK','2021-03-12'),(3,'Cy','US','2022-06-30'),(4,'Di','IN','2022-11-01');\nINSERT INTO products VALUES (1,'Keyboard','Tech',80.0),(2,'Mouse','Tech',25.0),(3,'Desk','Furniture',300.0),(4,'Lamp','Furniture',45.0);\nINSERT INTO orders VALUES (1,1,'2022-01-10','completed'),(2,1,'2022-02-14','completed'),(3,2,'2022-02-20','cancelled'),(4,3,'2022-03-05','completed'),(5,3,'2022-03-06','pending'),(6,1,'2023-01-02','completed');\nINSERT INTO order_items VALUES (1,1,1,2,80.0),(2,1,2,1,25.0),(3,2,3,1,300.0),(4,3,4,4,45.0),(5,4,2,3,25.0),(6,5,1,1,80.0),(7,6,4,2,45.0),(8,6,2,2,25.0);",
      "expectedOutput": [
        {
          "country": "IN",
          "customers": 1
        },
        {
          "country": "UK",
          "customers": 1
        },
        {
          "country": "US",
          "customers": 2
        }
      ],
      "expectedHash": "e12616f390122ff7720a45d4c8347fcca4b2ffd716837a924408d9d3478dfd4a"
    },
