{
  "id": "emp-duplicate-salaries",
  "number": 30,
  "title": "Salaries Paid To More Than One Person",
  "difficulty": "Medium",
  "tags": [
    "Group By",
    "Having"
  ],
  "description": "Report every salary figure that is paid to two or more employees, along with how many people receive it.\n\nName the columns `salary` and `people`. Return the result in any order.",
  "solutionSql": "SELECT salary, COUNT(*) AS people\nFROM employees\nWHERE salary IS NOT NULL\nGROUP BY salary\nHAVING COUNT(*) > 1;",
  "orderMatters": false,
  "hint": "GROUP BY collects NULLs into their own group — exclude them explicitly if they should not count.",
  "outputExplanation": "$120,000 is the only salary paid to more than one person — both Ben and Cara earn it. All other salaries are unique.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "salary": 120000,
          "people": 2
        }
      ],
      "expectedHash": "5bda68a15a5276bb4943b9f587b69b1c40526a3b9d3cfeed187f87f43f8caeee"
    },
