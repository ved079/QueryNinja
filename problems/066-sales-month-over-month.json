{
  "id": "sales-month-over-month",
  "number": 66,
  "title": "Month Over Month Revenue Change",
  "difficulty": "Medium",
  "tags": [
    "Window Function",
    "Date"
  ],
  "description": "For each month that has revenue, report its revenue and the change against the previous month **present in the data**. The earliest month reports NULL.\n\nName the columns `month`, `revenue` and `change`, with both amounts rounded to 2 decimals. Return the result in any order.",
  "solutionSql": "WITH monthly AS (\n  SELECT strftime('%Y-%m', o.order_date) AS month,\n         SUM(oi.quantity * oi.unit_price) AS revenue\n  FROM orders o\n  JOIN order_items oi ON oi.order_id = o.id\n  GROUP BY month\n)\nSELECT month,\n       ROUND(revenue, 2) AS revenue,\n       ROUND(revenue - LAG(revenue) OVER (ORDER BY month), 2) AS change\nFROM monthly;",
  "orderMatters": false,
  "hint": "Aggregate by month first; LAG over the aggregated rows compares each month to the previous one.",
  "outputExplanation": "Revenue rose from $185 in January 2022 to $480 in February, then fell to $155 in March, and was $140 in January 2023.",
  "schemaSql": "CREATE TABLE customers (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  country TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE products (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  category TEXT,\n  price REAL\n);\n\nCREATE TABLE orders (\n  id INTEGER PRIMARY KEY,\n  customer_id INTEGER,\n  order_date TEXT,\n  status TEXT\n);\n\nCREATE TABLE order_items (\n  id INTEGER PRIMARY KEY,\n  order_id INTEGER,\n  product_id INTEGER,\n  quantity INTEGER,\n  unit_price REAL\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO customers VALUES (1,'Ada','US','2021-01-05'),(2,'Bo','UK','2021-03-12'),(3,'Cy','US','2022-06-30'),(4,'Di','IN','2022-11-01');\nINSERT INTO products VALUES (1,'Keyboard','Tech',80.0),(2,'Mouse','Tech',25.0),(3,'Desk','Furniture',300.0),(4,'Lamp','Furniture',45.0);\nINSERT INTO orders VALUES (1,1,'2022-01-10','completed'),(2,1,'2022-02-14','completed'),(3,2,'2022-02-20','cancelled'),(4,3,'2022-03-05','completed'),(5,3,'2022-03-06','pending'),(6,1,'2023-01-02','completed');\nINSERT INTO order_items VALUES (1,1,1,2,80.0),(2,1,2,1,25.0),(3,2,3,1,300.0),(4,3,4,4,45.0),(5,4,2,3,25.0),(6,5,1,1,80.0),(7,6,4,2,45.0),(8,6,2,2,25.0);",
      "expectedOutput": [
        {
          "month": "2022-01",
          "revenue": 185,
          "change": null
        },
        {
          "month": "2022-02",
          "revenue": 480,
          "change": 295
        },
        {
          "month": "2022-03",
          "revenue": 155,
          "change": -325
        },
        {
          "month": "2023-01",
          "revenue": 140,
          "change": -15
        }
      ],
      "expectedHash": "4f91efd4ec320efcadcf727dae1568ce68d30a400f7da6388059f61ab540fe24"
    },
