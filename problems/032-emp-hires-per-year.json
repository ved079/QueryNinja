{
  "id": "emp-hires-per-year",
  "number": 32,
  "title": "Hires Per Year",
  "difficulty": "Medium",
  "tags": [
    "Date",
    "Group By"
  ],
  "description": "Report how many people were hired in each calendar year.\n\nName the columns `year` and `hires`. Return the result in any order.",
  "solutionSql": "SELECT strftime('%Y', hire_date) AS year, COUNT(*) AS hires\nFROM employees\nGROUP BY year;",
  "orderMatters": false,
  "hint": "strftime('%Y', date) extracts the year in SQLite; it returns text, not a number.",
  "outputExplanation": "One hire each in 2017, 2018, 2020, 2021, 2022 and 2023. Two hires in 2019.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "year": "2017",
          "hires": 1
        },
        {
          "year": "2018",
          "hires": 1
        },
        {
          "year": "2019",
          "hires": 2
        },
        {
          "year": "2020",
          "hires": 1
        },
        {
          "year": "2021",
          "hires": 1
        },
        {
          "year": "2022",
          "hires": 1
        },
        {
          "year": "2023",
          "hires": 1
        }
      ]
    },
    {
      "name": "Ties on every salary",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver');\nINSERT INTO employees VALUES\n (1,'A','Engineer',100000,1,NULL,'2020-01-01'),\n (2,'B','Engineer',100000,1,1,'2020-01-01'),\n (3,'C','Engineer',100000,1,1,'2020-01-01'),\n (4,'D','Rep',100000,2,NULL,'2020-01-01'),\n (5,'E','Rep',100000,2,4,'2020-01-01');",
      "expectedOutput": [
        {
          "year": "2020",
          "hires": 5
        }
      ]
    },
    {
      "name": "Department with no employees",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Ghost','Nowhere'),(3,'Empty','Nowhere');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',90000,1,NULL,'2019-01-01'),\n (2,'Ben','Engineer',80000,1,1,'2020-06-15');",
      "expectedOutput": [
        {
          "year": "2019",
          "hires": 1
        },
        {
          "year": "2020",
          "hires": 1
        }
      ]
