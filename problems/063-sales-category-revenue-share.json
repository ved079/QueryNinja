{
  "id": "sales-category-revenue-share",
  "number": 63,
  "title": "Each Category's Share Of Revenue",
  "difficulty": "Medium",
  "tags": [
    "Window Function"
  ],
  "description": "Report each product category's total revenue and its percentage of overall revenue, both rounded to 2 decimals. Ignore items whose product has no category.\n\nName the columns `category`, `revenue` and `pct`. Return the result in any order.",
  "solutionSql": "SELECT category,\n       ROUND(revenue, 2) AS revenue,\n       ROUND(100.0 * revenue / SUM(revenue) OVER (), 2) AS pct\nFROM (\n  SELECT p.category AS category, SUM(oi.quantity * oi.unit_price) AS revenue\n  FROM order_items oi\n  JOIN products p ON p.id = oi.product_id\n  WHERE p.category IS NOT NULL\n  GROUP BY p.category\n);",
  "orderMatters": false,
  "hint": "Aggregate to one row per category, then use SUM(...) OVER () to reach the grand total without a second scan.",
  "outputExplanation": "Furniture accounts for 59.38% of total revenue ($570) and Tech accounts for 40.63% ($390).",
  "schemaSql": "CREATE TABLE customers (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  country TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE products (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  category TEXT,\n  price REAL\n);\n\nCREATE TABLE orders (\n  id INTEGER PRIMARY KEY,\n  customer_id INTEGER,\n  order_date TEXT,\n  status TEXT\n);\n\nCREATE TABLE order_items (\n  id INTEGER PRIMARY KEY,\n  order_id INTEGER,\n  product_id INTEGER,\n  quantity INTEGER,\n  unit_price REAL\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO customers VALUES (1,'Ada','US','2021-01-05'),(2,'Bo','UK','2021-03-12'),(3,'Cy','US','2022-06-30'),(4,'Di','IN','2022-11-01');\nINSERT INTO products VALUES (1,'Keyboard','Tech',80.0),(2,'Mouse','Tech',25.0),(3,'Desk','Furniture',300.0),(4,'Lamp','Furniture',45.0);\nINSERT INTO orders VALUES (1,1,'2022-01-10','completed'),(2,1,'2022-02-14','completed'),(3,2,'2022-02-20','cancelled'),(4,3,'2022-03-05','completed'),(5,3,'2022-03-06','pending'),(6,1,'2023-01-02','completed');\nINSERT INTO order_items VALUES (1,1,1,2,80.0),(2,1,2,1,25.0),(3,2,3,1,300.0),(4,3,4,4,45.0),(5,4,2,3,25.0),(6,5,1,1,80.0),(7,6,4,2,45.0),(8,6,2,2,25.0);",
      "expectedOutput": [
        {
          "category": "Furniture",
          "revenue": 570,
          "pct": 59.38
        },
        {
          "category": "Tech",
          "revenue": 390,
          "pct": 40.63
        }
      ]
    },
