{
  "id": "act-longest-login-streak",
  "number": 81,
  "title": "Longest Daily Streak",
  "difficulty": "Hard",
  "tags": [
    "Gaps and Islands",
    "Window Function"
  ],
  "description": "For every user with at least one event, report the length of their longest run of **consecutive calendar days** with activity. A single active day counts as a streak of 1.\n\nName the columns `name` and `longest_streak`. Return the result in any order.",
  "solutionSql": "WITH days AS (\n  SELECT DISTINCT user_id, DATE(event_time) AS d FROM events\n),\ngrouped AS (\n  SELECT user_id, d,\n         DATE(d, '-' || ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY d) || ' day') AS grp\n  FROM days\n),\nruns AS (\n  SELECT user_id, grp, COUNT(*) AS len\n  FROM grouped\n  GROUP BY user_id, grp\n)\nSELECT u.name, MAX(r.len) AS longest_streak\nFROM runs r\nJOIN users u ON u.id = r.user_id\nGROUP BY u.id, u.name;",
  "orderMatters": false,
  "hint": "The gaps-and-islands trick: subtract a row number (in days) from each date. Consecutive dates all collapse to the same anchor date, which becomes the group key.",
  "outputExplanation": "Ada had a 3-day streak of consecutive active days. Bo and Cy each have a longest streak of 1 day.",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO users VALUES (1,'Ada','pro','2022-01-01'),(2,'Bo','free','2022-01-03'),(3,'Cy','pro','2022-02-10'),(4,'Di','free','2022-03-01');\nINSERT INTO events VALUES\n (1,1,'login','2022-03-01 09:00:00'),\n (2,1,'view','2022-03-01 09:05:00'),\n (3,1,'purchase','2022-03-01 09:40:00'),\n (4,1,'login','2022-03-02 10:00:00'),\n (5,1,'login','2022-03-03 11:00:00'),\n (6,2,'login','2022-03-01 08:00:00'),\n (7,2,'view','2022-03-05 08:10:00'),\n (8,3,'login','2022-03-02 20:00:00'),\n (9,3,'purchase','2022-03-02 20:30:00'),\n (10,3,'login','2022-03-04 21:00:00');",
      "expectedOutput": [
        {
          "name": "Ada",
          "longest_streak": 3
        },
        {
          "name": "Bo",
          "longest_streak": 1
        },
        {
          "name": "Cy",
          "longest_streak": 1
        }
      ]
    },
