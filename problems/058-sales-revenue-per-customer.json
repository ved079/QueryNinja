{
  "id": "sales-revenue-per-customer",
  "number": 58,
  "title": "Lifetime Spend Per Customer",
  "difficulty": "Medium",
  "tags": [
    "Join",
    "Aggregation"
  ],
  "description": "Report every customer's name and their total spend across **completed** orders only, rounded to 2 decimals. Customers with no completed orders report `0`.\n\nName the columns `customer` and `revenue`. Return the result in any order.",
  "solutionSql": "SELECT c.name AS customer,\n       ROUND(COALESCE(SUM(CASE WHEN o.status = 'completed' THEN oi.quantity * oi.unit_price END), 0), 2) AS revenue\nFROM customers c\nLEFT JOIN orders o ON o.customer_id = c.id\nLEFT JOIN order_items oi ON oi.order_id = o.id\nGROUP BY c.id, c.name;",
  "orderMatters": false,
  "hint": "Chain two LEFT JOINs so customers survive, and filter the status inside the SUM rather than in WHERE.",
  "outputExplanation": "Ada has spent $625, Cy has spent $75, and Bo and Di have spent nothing on completed orders.",
  "schemaSql": "CREATE TABLE customers (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  country TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE products (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  category TEXT,\n  price REAL\n);\n\nCREATE TABLE orders (\n  id INTEGER PRIMARY KEY,\n  customer_id INTEGER,\n  order_date TEXT,\n  status TEXT\n);\n\nCREATE TABLE order_items (\n  id INTEGER PRIMARY KEY,\n  order_id INTEGER,\n  product_id INTEGER,\n  quantity INTEGER,\n  unit_price REAL\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO customers VALUES (1,'Ada','US','2021-01-05'),(2,'Bo','UK','2021-03-12'),(3,'Cy','US','2022-06-30'),(4,'Di','IN','2022-11-01');\nINSERT INTO products VALUES (1,'Keyboard','Tech',80.0),(2,'Mouse','Tech',25.0),(3,'Desk','Furniture',300.0),(4,'Lamp','Furniture',45.0);\nINSERT INTO orders VALUES (1,1,'2022-01-10','completed'),(2,1,'2022-02-14','completed'),(3,2,'2022-02-20','cancelled'),(4,3,'2022-03-05','completed'),(5,3,'2022-03-06','pending'),(6,1,'2023-01-02','completed');\nINSERT INTO order_items VALUES (1,1,1,2,80.0),(2,1,2,1,25.0),(3,2,3,1,300.0),(4,3,4,4,45.0),(5,4,2,3,25.0),(6,5,1,1,80.0),(7,6,4,2,45.0),(8,6,2,2,25.0);",
      "expectedOutput": [
        {
          "customer": "Ada",
          "revenue": 625
        },
        {
          "customer": "Bo",
          "revenue": 0
        },
        {
          "customer": "Cy",
          "revenue": 75
        },
        {
          "customer": "Di",
          "revenue": 0
        }
      ]
    },
    {
      "name": "Customer who never ordered",
      "seedSql": "INSERT INTO customers VALUES (1,'Ada','US','2021-01-05'),(2,'Bo','UK','2021-03-12'),(3,'NoOrders','FR','2023-01-01');\nINSERT INTO products VALUES (1,'Keyboard','Tech',80.0),(2,'Mouse','Tech',25.0);\nINSERT INTO orders VALUES (1,1,'2022-01-10','completed'),(2,2,'2022-01-11','completed');\nINSERT INTO order_items VALUES (1,1,1,1,80.0),(2,2,2,2,25.0);",
      "expectedOutput": [
        {
          "customer": "Ada",
          "revenue": 80
        },
        {
          "customer": "Bo",
          "revenue": 50
        },
        {
          "customer": "NoOrders",
          "revenue": 0
        }
      ]
    },
