      "name": "Example",
      "seedSql": "INSERT INTO Employee VALUES (1,100),(2,200),(3,300),(4,200);",
      "expectedOutput": [
        {
          "SecondHighestSalary": 200
        }
      ],
      "expectedHash": "1152d6c8e00d1ee063ea6752d40f122fc85440a18c85342748dac9c2865a7607"
    },
    {
