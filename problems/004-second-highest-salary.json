{
  "id": "second-highest-salary",
  "number": 4,
  "title": "Second Highest Salary",
  "difficulty": "Medium",
  "tags": [
    "Subquery",
    "Aggregation"
  ],
  "description": "Table `Employee` holds employee salaries.\n\nWrite a query to report the **second highest distinct** salary. If there is no second highest salary, report `NULL`.\n\nName the output column `SecondHighestSalary`. The result must be exactly one row.",
  "schemaSql": "CREATE TABLE Employee (\n  id INTEGER PRIMARY KEY,\n  salary INTEGER\n);",
  "solutionSql": "SELECT (\n  SELECT DISTINCT salary\n  FROM Employee\n  ORDER BY salary DESC\n  LIMIT 1 OFFSET 1\n) AS SecondHighestSalary;",
  "orderMatters": false,
  "hint": "LIMIT 1 OFFSET 1 over DISTINCT salaries gets the value — but wrapping it in an outer SELECT is what guarantees one row (NULL) when it doesn't exist.",
  "outputExplanation": "The distinct salaries are 100, 200 and 300. After the highest (300), the second highest is 200.",
