{
  "id": "emp-longest-tenured-per-department",
  "number": 31,
  "title": "Longest-Serving Person Per Department",
  "difficulty": "Medium",
  "tags": [
    "Window Function"
  ],
  "description": "Report the earliest-hired employee in each department. If several were hired on the same earliest date, report all of them.\n\nName the columns `dept_id`, `name` and `hire_date`. Return the result in any order.",
  "solutionSql": "SELECT dept_id, name, hire_date\nFROM (\n  SELECT *, RANK() OVER (PARTITION BY dept_id ORDER BY hire_date) AS rnk\n  FROM employees\n)\nWHERE rnk = 1;",
  "orderMatters": false,
  "hint": "RANK() keeps every tied row at rank 1; ROW_NUMBER() would arbitrarily pick one.",
  "outputExplanation": "Ava (2018-01-15) is the longest-serving employee in Engineering, Eve (2017-11-02) in Sales, and Hal (2023-09-01) is the only employee in HR.",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO departments VALUES (1,'Engineering','Austin'),(2,'Sales','Denver'),(3,'HR','Austin');\nINSERT INTO employees VALUES\n (1,'Ava','Manager',150000,1,NULL,'2018-01-15'),\n (2,'Ben','Engineer',120000,1,1,'2019-03-01'),\n (3,'Cara','Engineer',120000,1,1,'2019-03-01'),\n (4,'Dan','Engineer',95000,1,1,'2021-07-19'),\n (5,'Eve','Manager',130000,2,NULL,'2017-11-02'),\n (6,'Finn','Rep',70000,2,5,'2020-05-30'),\n (7,'Gia','Rep',85000,2,5,'2022-02-14'),\n (8,'Hal','Analyst',60000,3,NULL,'2023-09-01');",
      "expectedOutput": [
        {
          "dept_id": 1,
          "name": "Ava",
          "hire_date": "2018-01-15"
        },
        {
          "dept_id": 2,
          "name": "Eve",
          "hire_date": "2017-11-02"
        },
        {
          "dept_id": 3,
          "name": "Hal",
          "hire_date": "2023-09-01"
        }
      ],
      "expectedHash": "3c3a20235be1c4e2932cc39cead0dcbd8a82d30378377093524a2dc5f10e1191"
    },
