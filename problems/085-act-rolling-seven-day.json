{
  "id": "act-rolling-seven-day",
  "number": 85,
  "title": "Rolling Seven-Day Activity",
  "difficulty": "Hard",
  "tags": [
    "Window Function",
    "Date"
  ],
  "description": "For each day with activity, report the number of events that occurred within the seven-day window ending on that day (the day itself plus the six calendar days before it).\n\nName the columns `day` and `events_7d`. Return the result in any order.",
  "solutionSql": "WITH daily AS (\n  SELECT DATE(event_time) AS day, COUNT(*) AS n FROM events GROUP BY day\n)\nSELECT day,\n       SUM(n) OVER (ORDER BY JULIANDAY(day) RANGE BETWEEN 6 PRECEDING AND CURRENT ROW) AS events_7d\nFROM daily;",
  "orderMatters": false,
  "hint": "A ROWS frame counts rows present in the data; a RANGE frame over JULIANDAY counts actual calendar distance — which is what \"seven days\" means.",
  "outputExplanation": "The 7-day event window grew from 4 events on March 1 to 10 events on March 5 as each new day's events were added.",
  "schemaSql": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  plan TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER,\n  event_type TEXT,\n  event_time TEXT\n);",
  "tests": [
