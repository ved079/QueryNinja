{
  "id": "department-top-three-salaries",
  "number": 7,
  "title": "Department Top Three Salaries",
  "difficulty": "Hard",
  "tags": [
    "Window Function",
    "Join",
    "Ranking"
  ],
  "description": "Table `Employee` holds employees and their salary, with `departmentId` referencing `Department.id`.\n\nAn employee is a **high earner** in a department if there are fewer than three *distinct* salaries in that department strictly greater than theirs.\n\nWrite a query to find the high earners in each department. Report columns `Department`, `Employee`, `Salary`.\n\nReturn the result in any order.",
  "schemaSql": "CREATE TABLE Department (\n  id INTEGER PRIMARY KEY,\n  name TEXT\n);\n\nCREATE TABLE Employee (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  salary INTEGER,\n  departmentId INTEGER\n);",
  "solutionSql": "SELECT d.name AS Department, e.name AS Employee, e.salary AS Salary\nFROM (\n  SELECT *,\n         DENSE_RANK() OVER (PARTITION BY departmentId ORDER BY salary DESC) AS rnk\n  FROM Employee\n) e\nJOIN Department d ON d.id = e.departmentId\nWHERE e.rnk <= 3;",
  "orderMatters": false,
  "hint": "DENSE_RANK() (not RANK() or ROW_NUMBER()) is what treats tied salaries as one rank — exactly what \"distinct salaries greater than theirs\" means.",
  "outputExplanation": "In IT, Max ($90k), Joe ($85k), Randy ($85k) and Will ($70k) are the top three earners. In Sales, Henry ($80k) and Sam ($60k) qualify.",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO Department VALUES (1,'IT'),(2,'Sales');\nINSERT INTO Employee VALUES (1,'Joe',85000,1),(2,'Henry',80000,2),(3,'Sam',60000,2),(4,'Max',90000,1),(5,'Janet',69000,1),(6,'Randy',85000,1),(7,'Will',70000,1);",
      "expectedOutput": [
        {
          "Department": "IT",
          "Employee": "Max",
          "Salary": 90000
        },
        {
          "Department": "IT",
          "Employee": "Joe",
          "Salary": 85000
        },
        {
          "Department": "IT",
          "Employee": "Randy",
          "Salary": 85000
        },
        {
          "Department": "IT",
          "Employee": "Will",
          "Salary": 70000
        },
        {
          "Department": "Sales",
          "Employee": "Henry",
          "Salary": 80000
        },
        {
          "Department": "Sales",
          "Employee": "Sam",
          "Salary": 60000
        }
      ],
      "expectedHash": "4bc99b5ba5d22a11eef6020c8513e7654af091fee8614dbf0ecd50de8ea993b0"
    },
