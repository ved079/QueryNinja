{
  "id": "sales-customers-above-country-average",
  "number": 65,
  "title": "Spending More Than Your Country's Average",
  "difficulty": "Medium",
  "tags": [
    "Window Function",
    "Join"
  ],
  "description": "For each customer compute their total spend over all order items. Report those who spend strictly more than the average spend of customers in the same country. Customers who never ordered count as spending 0.\n\nName the columns `customer`, `country` and `spend`, with spend rounded to 2 decimals. Return the result in any order.",
  "solutionSql": "WITH spend AS (\n  SELECT c.id, c.name, c.country,\n         COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS total\n  FROM customers c\n  LEFT JOIN orders o ON o.customer_id = c.id\n  LEFT JOIN order_items oi ON oi.order_id = o.id\n  GROUP BY c.id, c.name, c.country\n)\nSELECT name AS customer, country, ROUND(total, 2) AS spend\nFROM (SELECT *, AVG(total) OVER (PARTITION BY country) AS country_avg FROM spend)\nWHERE total > country_avg;",
  "orderMatters": false,
  "hint": "Compute the per-customer totals first, then apply a window average over country to that derived table.",
  "outputExplanation": "Ada spends $625, well above the US average of $350. Cy ($75), Bo ($0) and Di ($0) all spend at or below their country's average.",
  "schemaSql": "CREATE TABLE customers (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  country TEXT,\n  signup_date TEXT\n);\n\nCREATE TABLE products (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  category TEXT,\n  price REAL\n);\n\nCREATE TABLE orders (\n  id INTEGER PRIMARY KEY,\n  customer_id INTEGER,\n  order_date TEXT,\n  status TEXT\n);\n\nCREATE TABLE order_items (\n  id INTEGER PRIMARY KEY,\n  order_id INTEGER,\n  product_id INTEGER,\n  quantity INTEGER,\n  unit_price REAL\n);",
  "tests": [
    {
      "name": "Example",
      "seedSql": "INSERT INTO customers VALUES (1,'Ada','US','2021-01-05'),(2,'Bo','UK','2021-03-12'),(3,'Cy','US','2022-06-30'),(4,'Di','IN','2022-11-01');\nINSERT INTO products VALUES (1,'Keyboard','Tech',80.0),(2,'Mouse','Tech',25.0),(3,'Desk','Furniture',300.0),(4,'Lamp','Furniture',45.0);\nINSERT INTO orders VALUES (1,1,'2022-01-10','completed'),(2,1,'2022-02-14','completed'),(3,2,'2022-02-20','cancelled'),(4,3,'2022-03-05','completed'),(5,3,'2022-03-06','pending'),(6,1,'2023-01-02','completed');\nINSERT INTO order_items VALUES (1,1,1,2,80.0),(2,1,2,1,25.0),(3,2,3,1,300.0),(4,3,4,4,45.0),(5,4,2,3,25.0),(6,5,1,1,80.0),(7,6,4,2,45.0),(8,6,2,2,25.0);",
