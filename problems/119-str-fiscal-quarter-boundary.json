      "expectedOutput": [
        {
          "name": "Ava",
          "fiscal_quarter": "FY2017-Q4"
        },
        {
          "name": "Ben",
          "fiscal_quarter": "FY2018-Q4"
        },
        {
          "name": "Cara",
          "fiscal_quarter": "FY2018-Q4"
        },
        {
