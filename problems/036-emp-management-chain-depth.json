{
  "id": "emp-management-chain-depth",
  "number": 36,
  "title": "Depth In The Management Chain",
  "difficulty": "Hard",
  "tags": [
    "Recursive CTE",
    "Hierarchy"
  ],
  "description": "Every employee sits somewhere in a management tree. Report each employee's depth, where an employee with no manager is at depth 1, their direct reports at depth 2, and so on.\n\nName the columns `name` and `depth`. Return the result in any order.",
  "solutionSql": "WITH RECURSIVE chain(id, name, depth) AS (\n  SELECT id, name, 1 FROM employees WHERE manager_id IS NULL\n  UNION ALL\n  SELECT e.id, e.name, c.depth + 1\n  FROM employees e\n  JOIN chain c ON e.manager_id = c.id\n)\nSELECT name, depth FROM chain;",
  "orderMatters": false,
  "hint": "A recursive CTE: the anchor picks the roots (no manager), the recursive arm joins children to already-found parents and adds one.",
  "outputExplanation": "Ava, Eve and Hal are at depth 1 (no manager). Ben, Cara, Dan, Finn and Gia are at depth 2 (they report to depth-1 managers).",
  "schemaSql": "CREATE TABLE departments (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  location TEXT\n);\n\nCREATE TABLE employees (\n  id INTEGER PRIMARY KEY,\n  name TEXT,\n  title TEXT,\n  salary INTEGER,\n  dept_id INTEGER,\n  manager_id INTEGER,\n  hire_date TEXT\n);",
  "tests": [
